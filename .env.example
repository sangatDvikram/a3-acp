# =============================================================================
# .env.example — Environment variable template
# =============================================================================
# Copy this file to .env and fill in the real values.
# The .env file must NEVER be committed to version control.
# Make sure .env is listed in your .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# ODBC / MSSQL Database  (inc/config.php, ultimate_classes/class.Dbconnections.php)
# -----------------------------------------------------------------------------
ODBC_DB_USERNAME=sa
ODBC_DB_PASSWORD=your_odbc_password_here


# -----------------------------------------------------------------------------
# MySQL Database  (inc/config.php, conn/pdoclass.php, inc/pdoclass.php)
# -----------------------------------------------------------------------------
MYSQL_DB_HOST=localhost
MYSQL_DB_NAME=a3acp
MYSQL_DB_USERNAME=your_mysql_user_here
MYSQL_DB_PASSWORD=your_mysql_password_here


# -----------------------------------------------------------------------------
# Transwise App MySQL Database  (transwise-client-app/api/application/api/pdo.php)
# -----------------------------------------------------------------------------
TRANSWISE_DB_USERNAME=your_transwise_db_user_here
TRANSWISE_DB_PASSWORD=your_transwise_db_password_here


# -----------------------------------------------------------------------------
# PayU Live Payment Gateway  (Payu/index.php, Payu/success.php)
# Obtain from your PayU merchant dashboard.
# -----------------------------------------------------------------------------
PAYU_MERCHANT_KEY=your_live_merchant_key_here
PAYU_SALT=your_live_salt_here


# -----------------------------------------------------------------------------
# PayU Test / Sandbox Payment Gateway  (Payu/index1.php)
# -----------------------------------------------------------------------------
PAYU_TEST_MERCHANT_KEY=your_test_merchant_key_here
PAYU_TEST_SALT=your_test_salt_here


# -----------------------------------------------------------------------------
# PayPal  (testpaypal/payments.php, testpaypal/ipn.php)
# PAYPAL_EMAIL      — the PayPal account that receives payments (receiver_email).
# PAYPAL_ADMIN_EMAIL — internal admin address for fraud/IPN alert emails.
# -----------------------------------------------------------------------------
PAYPAL_EMAIL=your_paypal_receiver_email_here
PAYPAL_SANDBOX_EMAIL=your_paypal_sandbox_facilitator_email_here
PAYPAL_ADMIN_EMAIL=your_admin_email_here


# -----------------------------------------------------------------------------
# Mailer / Transwise Email  (transwise-client-app/api/application/email.php,
#                            transwise-client-app/api/application/mailer.php)
# MAIL_TO   — default recipient address for outbound application emails.
# MAIL_FROM — the From/Reply-To address shown on sent emails.
# MAILER_BOOKING_ID — booking reference ID used by SendMail().
# -----------------------------------------------------------------------------
MAIL_TO=your_recipient_email_here
MAIL_FROM=admin@yourdomain.com
MAILER_BOOKING_ID=your_booking_id_here


# -----------------------------------------------------------------------------
# Geekstoy API  (geekstoy/login.php)
# GEEKSTOY_SEC_KEY — cryptographically random key used to authenticate
#                    requests to the Geekstoy login endpoint.
# -----------------------------------------------------------------------------
GEEKSTOY_SEC_KEY=your_random_secret_key_here
GEEKSTOY_DB_USERNAME=your_geekstoy_db_user_here
GEEKSTOY_DB_PASSWORD=your_geekstoy_db_password_here


# -----------------------------------------------------------------------------
# Support / Contact Info  (Payu/failure.php, register.php)
# SUPPORT_PHONE — public-facing support phone number displayed on payment
#                 failure pages and in registration confirmation emails.
#                 Replace with a dedicated support line, not a personal number.
# -----------------------------------------------------------------------------
SUPPORT_PHONE=your_support_phone_number_here


# -----------------------------------------------------------------------------
# Support / Contact Info  (Payu/failure.php, register.php)
# SUPPORT_PHONE — public-facing support phone number displayed on payment
#                 failure pages and in registration confirmation emails.
#                 Replace with a dedicated support line, not a personal number.
# -----------------------------------------------------------------------------
SUPPORT_PHONE=your_support_phone_number_here
